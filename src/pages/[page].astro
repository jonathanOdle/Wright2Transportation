---
import Layout from '../layouts/Layout.astro';
import SimpleHero from '../components/SimpleHero.astro';
import ButtonLink from '../components/ButtonLink.astro';
import {company} from '../data/company';
export function getStaticPaths(){return ['services','equipment','safety','about','privacy','terms','accessibility'].map(page=>({params:{page}}));}
const pages = {
 services: {title:'Fly Ash & Dry Bulk Transportation Texas', heading:'Hauling that keeps business moving.', description:'Professional dry bulk transportation supporting Texas concrete, cement, and construction-material operations.', items:company.serviceDetails},
 equipment: {title:'Dry Bulk Trucking Equipment',heading:'Equipment built for the work.',description:'Specialized hauling requires equipment suited to the material, the facility, and the job.',items:[{title:'Commercial tractors',body:'The tractor is the working foundation of a dry bulk operation. Contact our team to discuss equipment suitability for your facilities.'},{title:'Dry bulk trailers',body:'Fly ash transportation calls for specialized bulk trailers. Material compatibility, access, and unloading requirements should be discussed before scheduling transportation.'},{title:'Plan the details',body:'Share your loading and receiving requirements so our team can discuss appropriate equipment for your work.'}]},
 safety: {title:'Trucking Safety',heading:'Safety starts before the truck moves.',description:'Responsible driving and attention to the details matter on every trip.',items:[{title:'Driver responsibility',body:'Stay alert, plan the trip, and communicate changing road and facility conditions.'},{title:'Equipment inspections',body:'Pre-trip and post-trip inspections help identify issues before equipment returns to the road.'},{title:'Maintenance awareness',body:'Report equipment concerns promptly. Safe operation depends on addressing mechanical issues.'},{title:'Loading and unloading',body:'Understand the material, follow facility procedures, and confirm connections and receiving instructions before work begins.'},{title:'Compliance',body:'Commercial driving requires attention to applicable DOT requirements, hours of service, and required documentation.'},{title:'Facility safety',body:'Respect site traffic patterns, pedestrian areas, posted limits, and required protective equipment.'}]},
 about: {title:'About Wright 2 Transportation',heading:'Built around the work.',description:company.about.companyStory,items:company.about.principles},
 privacy: {title:'Privacy Policy',heading:'Your information matters.',description:'Draft policy — final language and data-handling practices must be reviewed before launch.',items:[{title:'Information you provide',body:'Contact inquiries and driver applications may include contact information, work history, and documents you choose to upload. Do not submit Social Security numbers, banking details, medical records, or full license numbers.'},{title:'How information is used',body:'When submission services are enabled, information is intended to help respond to transportation inquiries and evaluate employment interest. Submitting interest does not guarantee employment.'},{title:'Service providers and retention',body:'Before launch, Wright 2 must confirm its form providers, who can access submissions, retention periods, deletion process, and privacy contact.'},{title:'Analytics, cookies, and logs',body:'Analytics is optional and disabled unless configured. Hosting providers may process technical request logs. Any enabled analytics and cookie practices must be reflected in the final policy.'},{title:'Privacy requests',body:'A verified privacy contact will be published when available. Avoid sending confidential documents until the collection service and final privacy policy are in place.'}]},
 terms: {title:'Terms of Use',heading:'Website terms.',description:'Draft website terms for review before launch.',items:[{title:'Website information',body:'This website provides general information about Wright 2 Transportation. Service availability and employment details must be confirmed directly with the company.'},{title:'Inquiries and applications',body:'A website inquiry is not a transportation contract, booking confirmation, or offer of employment.'},{title:'Content and use',body:'Company branding and website content are provided for informational use. Final ownership, liability, and governing-law terms require review before launch.'}]},
 accessibility: {title:'Accessibility',heading:'Built to be usable.',description:'We aim to make this website straightforward to use on a phone, with a keyboard, or with assistive technology.',items:[{title:'Navigation',body:'Use the skip link to reach the main content. All navigation links and forms are accessible by keyboard. On small screens, use the Menu control to open navigation.'},{title:'Forms',body:'Fields have visible labels and validation messages. Required fields are identified, and form status is announced to assistive technology.'},{title:'Ongoing improvement',body:'Accessibility is an ongoing effort. If a feature prevents you from using the site, share the page and a description of the issue through the contact form when available.'}]}
};
const page=Astro.params.page as keyof typeof pages;
const content=pages[page];
---
<Layout title={content.title} pathname={`/${page}`} description={content.description} noindex={['privacy','terms'].includes(page)}><SimpleHero label={page} title={content.heading} description={content.description}/><section class="section section--light"><div class="container reading-list">{content.items.map((item,index)=><article><span class="row-number">{String(index+1).padStart(2,'0')}</span><div><h2>{item.title}</h2><p>{item.body}</p></div></article>)}{['services','equipment','safety','about'].includes(page)&&<div class="actions"><ButtonLink href="/contact">Talk With Wright 2 →</ButtonLink><a href="/drivers" class="text-link">Interested in driving?</a></div>}</div></section></Layout>
