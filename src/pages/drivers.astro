---
import Layout from '../layouts/Layout.astro';
import SimpleHero from '../components/SimpleHero.astro';
import ButtonLink from '../components/ButtonLink.astro';
import InquiryForm from '../components/InquiryForm.astro';
import {company} from '../data/company';
import { withBase } from '../lib/base-url';
---
<Layout title="CDL Driver Jobs in Texas" pathname="/drivers" description="Explore professional dry bulk driving opportunities with Wright 2 Transportation in Texas."><SimpleHero label="Drive with Wright 2" title="Your next mile starts here." description="Take pride in your work, your equipment, and doing the job safely. Start a conversation about driving with Wright 2 Transportation."><div class="actions"><ButtonLink href={withBase('/drivers#application')}>Apply to Drive →</ButtonLink><a class="text-link" href={withBase('/drivers#requirements')}>Driver requirements</a></div></SimpleHero><section class="section section--light"><div class="container split-layout"><div><p class="eyebrow">Specialized work. Professional drivers.</p><h2>More than miles.</h2><p class="lead">Dry bulk trucking supports the industries that keep Texas building.</p><p>The work may involve material terminals, concrete-related facilities, specialized trailers, and careful loading and unloading. Tell us about your experience and what you're looking for.</p><details class="faq"><summary>What about pay, home time, and benefits?</summary><p>Our team will discuss current opportunities and their specific pay, schedules, home time, and benefits directly. These details have not yet been published.</p></details>{company.driverBenefits.length>0&&company.driverBenefits.map(benefit=><p><strong>{benefit.label}:</strong> {benefit.value}</p>)}</div><div id="requirements"><p class="eyebrow">Before you apply</p><h2>Let's talk qualifications.</h2><p style="margin-top:20px">Be ready to discuss your CDL class, driving experience, and familiarity with dry bulk equipment. Pneumatic or dry bulk experience is preferred.</p><p>Our team will confirm current company and insurance requirements during the recruiting process.</p><p>No Social Security number, full license number, or medical documents are needed for this initial application.</p></div></div></section><section class="section section--light" id="application" style="border-top:1px solid #cbd0d5"><div class="container"><p class="eyebrow">Start a conversation</p><h2>Driver application.</h2><p style="margin-top:20px">Tell us a little about yourself and your driving experience.</p><InquiryForm kind="driver"/></div></section></Layout>
