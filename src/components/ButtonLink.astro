---
import { withBase } from '../lib/base-url';

interface Props {
	href: string;
	variant?: 'primary' | 'secondary' | 'ghost';
	analyticsEvent?: string;
	className?: string;
	newTab?: boolean;
}

const { href, variant = 'primary', analyticsEvent, className = '', newTab = false } = Astro.props;
const resolvedHref = withBase(href);
---

<a
	href={resolvedHref}
	class={`button button--${variant} ${className}`.trim()}
	{...(analyticsEvent ? { 'data-analytics-event': analyticsEvent } : {})}
	{...(newTab ? { target: '_blank', rel: 'noreferrer' } : {})}
>
	<slot />
</a>