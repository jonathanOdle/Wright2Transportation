---
import type { FeatureItem } from '../data/company';

interface Props {
	items: FeatureItem[];
	variant?: 'default' | 'dark';
	columns?: '2' | '3';
}

const { items, variant = 'default', columns = '3' } = Astro.props;
---

<div class:list={["card-grid", variant === 'dark' && 'card-grid--dark', columns === '2' && 'card-grid--wide']}>
	{items.map((item) => (
		<article class="card-panel">
			{item.eyebrow && <p class="card-panel__eyebrow">{item.eyebrow}</p>}
			<h3>{item.title}</h3>
			<p>{item.body}</p>
			{item.href && item.ctaLabel && (
				<a class="text-link" href={item.href}>
					{item.ctaLabel}
				</a>
			)}
		</article>
	))}
</div>