---
import {heroImages} from '../data/hero-images';
interface Props { label: string; title: string; description: string; }
const {label,title,description}=Astro.props;
const page=Astro.url.pathname.split('/').filter(Boolean)[0];
const image=heroImages[page];
---
<section class:list={['simple-hero',image && 'simple-hero--image']} style={image ? `--hero-position:${image.position}` : undefined}>
 {image && <img class="simple-hero__image" src={image.src} srcset={`${image.src.replace('.webp','-small.webp')} 960w, ${image.src} 1920w`} sizes="100vw" width="1920" height="640" alt={image.alt} fetchpriority="high" decoding="async" />}
 <div class="container"><p class="eyebrow">{label}</p><h1>{title}</h1><p class="lead">{description}</p><slot /></div>
</section>
