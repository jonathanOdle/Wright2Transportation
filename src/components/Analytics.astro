---
const configuredId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
const ga4MeasurementId = /^G-[A-Z0-9]+$/.test(configuredId || '') ? configuredId : undefined;
---

{ga4MeasurementId && (
	<>
		<script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4MeasurementId}`}></script>
		<script define:vars={{ ga4MeasurementId }}>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				window.dataLayer.push(arguments);
			}
			window.gtag = gtag;
			gtag('js', new Date());
			gtag('config', ga4MeasurementId);
		</script>
	</>
)}

<script>
	const trackClick = (eventName: string | null, label: string) => {
        const analyticsWindow = window as Window & {gtag?: (...args: unknown[]) => void};
		if (eventName && typeof analyticsWindow.gtag === 'function') {
			analyticsWindow.gtag('event', eventName, { event_label: label });
		}
	};

	for (const node of document.querySelectorAll('[data-analytics-event]')) {
		node.addEventListener('click', () => {
			trackClick(node.getAttribute('data-analytics-event'), node.textContent?.trim() ?? 'link');
		});
	}
</script>