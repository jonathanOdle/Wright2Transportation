---
import { company, hasValue } from '../data/company';
import { withBase } from '../lib/base-url';

const mainPhoneHref = hasValue(company.contacts.mainPhone) ? `tel:${company.contacts.mainPhone.replace(/[^\d+]/g, '')}` : '';
const mainEmailHref = hasValue(company.contacts.businessEmail) ? `mailto:${company.contacts.businessEmail}` : '';
---

<footer class="site-footer">
	<div class="container site-footer__grid">
		<div>
			<a class="site-footer__brand" href={withBase('/')} aria-label={`${company.name} home`}>
				<img class="footer-logo" src={withBase(company.brand.footerLogoPath)} alt="Wright 2 Transportation — Driving a Stronger Tomorrow" width="1536" height="1024" loading="lazy" />
			</a>
			<p class="site-footer__description">Professional dry bulk transportation serving Texas.</p>
		</div>

		<div>
			<p class="site-footer__title">Navigate</p>
			<ul class="site-footer__list">
				{company.navigation.map((item) => (
					<li><a href={withBase(item.href)}>{item.label}</a></li>
				))}
			</ul>
		</div>

		<div>
			<p class="site-footer__title">Contact</p>
			<ul class="site-footer__list">
				{mainPhoneHref && (
					<li>
						<a href={mainPhoneHref} data-analytics-event={company.analytics.events.businessPhoneClicked}>{company.contacts.mainPhone}</a>
					</li>
				)}
				{mainEmailHref && (
					<li>
						<a href={mainEmailHref}>{company.contacts.businessEmail}</a>
					</li>
				)}
				{company.contacts.addressLines.map((line) => (
					<li>{line}</li>
				))}
				{!mainPhoneHref && !mainEmailHref && !hasValue(company.contacts.addressLines) && <li><a href={withBase('/contact')}>Transportation inquiries →</a></li><li><a href={withBase('/drivers#application')}>Driver applications →</a></li>}
			</ul>
		</div>

		<div>
			<p class="site-footer__title">More</p>
			<ul class="site-footer__list">
				{company.footerLinks.map((item) => (
					<li><a href={withBase(item.href)}>{item.label}</a></li>
				))}
				{company.socialLinks.map((link) => (
					<li><a href={link.href}>{link.label}</a></li>
				))}
			</ul>
		</div>
	</div>

	<div class="site-footer__bottom">
		<div class="container site-footer__bottom-inner">
			<p>© Wright 2 Transportation. All Rights Reserved.</p>
			<p>{company.tagline}</p>
		</div>
	</div>
</footer>